# SPDX-License-Identifier: Unlicense

config SOC_FAMILY_V7M_RVM
	bool

config SOC_FAMILY
	default "v7m_rvm" if SOC_FAMILY_V7M_RVM

config SOC_SERIES_V7M_RVM
	bool
	select SOC_FAMILY_V7M_RVM

config SOC_SERIES
	default "v7m_rvm" if SOC_SERIES_V7M_RVM

config SOC_RVM
	bool
	select SOC_SERIES_V7M_RVM
	select ARM

choice RVM_CPU
	prompt "RVM guest CPU"
	default RVM_CPU_M7
	help
	  The virtual board has one identity; the project generator selects
	  the CPU/FPU model from the virtual machine coprocessor.

config RVM_CPU_M7
	bool "Cortex-M7 / FPv5-DP"
	select CPU_CORTEX_M7
	select CPU_HAS_FPU
	select CPU_HAS_FPU_DOUBLE_PRECISION

config RVM_CPU_M4
	bool "Cortex-M4F / FPv4-SP"
	select CPU_CORTEX_M4
	select CPU_HAS_FPU

endchoice

config SOC
	default "rvm" if SOC_RVM

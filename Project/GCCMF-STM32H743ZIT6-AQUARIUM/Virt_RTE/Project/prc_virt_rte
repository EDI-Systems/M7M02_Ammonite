# Generated by RTE_Gen: the virt_rte makefile drives the RTEMS waf build.
TARGET := virt_rte
OBJDIR := Object
RTEMS_DIR := C:/Code_Library/RTEMS_V701/
RTEMS_PREFIX ?=
ifeq ($(strip $(RTEMS_PREFIX)),)
  RTEMS_GCC := $(shell command -v arm-rtems7-gcc 2>/dev/null)
  RTEMS_PREFIX := $(patsubst %/bin/arm-rtems7-gcc,%,$(patsubst %.exe,%,$(RTEMS_GCC)))
endif
RTEMS_PREFIX_POSIX := $(shell command -v cygpath >/dev/null 2>&1 && cygpath -u '$(RTEMS_PREFIX)' || echo '$(RTEMS_PREFIX)')
RTEMS_PREFIX_NATIVE := $(shell command -v cygpath >/dev/null 2>&1 && cygpath -m '$(RTEMS_PREFIX)' || echo '$(RTEMS_PREFIX)')
RTEMS_BSP := arm/v7m_rvm
RTE_APP := prc_virt_rte
RTE_CFG := $(CURDIR)/rte_config.ini
RTE_COPY := $(CURDIR)/rte_copy.sh
PYTHON ?= python3
OBJCOPY := $(if $(strip $(RTEMS_PREFIX_NATIVE)),$(RTEMS_PREFIX_NATIVE)/bin/arm-rtems7-objcopy,arm-rtems7-objcopy)
RTEMS_TOOLS := $(if $(strip $(RTEMS_PREFIX_NATIVE)),--rtems-tools=$(RTEMS_PREFIX_NATIVE),)
WIN := $(findstring MINGW,$(shell uname -s))$(findstring MSYS,$(shell uname -s))
BINCOPY := ../../../../Utility/M7M02_Final/bincopy
ifneq ($(strip $(WIN)),)
  BINCOPY := ../../../../Utility/M7M02_Final/bincopy.exe
endif

export PATH := $(if $(RTEMS_PREFIX_POSIX),$(RTEMS_PREFIX_POSIX)/bin:)$(PATH)
ifneq ($(strip $(WIN)),)
  export USERPROFILE := $(shell cygpath -w "$(HOME)")
  export TEMP := C:/Temp
  export TMP := C:/Temp
  export TMPDIR := C:/Temp
endif

.PHONY: all clean rte_force
all: virt_rte_image.c

$(OBJDIR):
	mkdir -p $(OBJDIR)

# The RTEMS tree and its build directory are shared.  Re-stage this VM and
# reconfigure on every build so a previous VM's layout cannot leak in;
# Virt builds must be serialized by the caller.
$(OBJDIR)/virt_rte.bin: rte_force | $(OBJDIR)
	sh $(RTE_COPY)
	cd $(RTEMS_DIR) && $(PYTHON) ./waf configure --rtems-config=$(RTE_CFG) $(if $(strip $(RTEMS_PREFIX)),--prefix=$(RTEMS_PREFIX_POSIX),) $(RTEMS_TOOLS)
	rm -f $(RTEMS_DIR)/build/$(RTEMS_BSP)/testsuites/samples/$(RTE_APP).exe
	cd $(RTEMS_DIR) && $(PYTHON) ./waf
	$(OBJCOPY) -O binary $(RTEMS_DIR)/build/$(RTEMS_BSP)/testsuites/samples/$(RTE_APP).exe $@

virt_rte_image.c: $(OBJDIR)/virt_rte.bin
	$(BINCOPY) -i $< -o $@

rte_force:

clean:
	rm -rf $(OBJDIR) virt_rte_image.c


BOARD_CONFIG := C:/Code_Library/M7M02_Ammonite/Project/GCCMF-STM32H743ZIT6-AQUARIUM/Virt_NTX/Project/ntx_board/configs/virt
BUILD_DIR := $(CURDIR)/build

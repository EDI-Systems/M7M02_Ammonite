.PHONY: all clean ntx_force
all: virt_ntx_image.c

$(OBJDIR):
	mkdir -p $(OBJDIR)

# Every Virt has its own build directory; regenerate the config so a
# previous VM layout can never leak into this image.
$(OBJDIR)/virt_ntx.bin: ntx_force | $(OBJDIR)
	rm -rf $(BUILD_DIR)
	$(CMAKE) -S $(NTX_ROOT) -B $(BUILD_DIR) -GNinja -DBOARD_CONFIG=$(BOARD_CONFIG)
	$(CMAKE) --build $(BUILD_DIR) -j
	cp $(BUILD_DIR)/nuttx.bin $@

virt_ntx_image.c: $(OBJDIR)/virt_ntx.bin

CMAKE ?= cmake
PREFIX ?=
ifeq ($(strip $(PREFIX)),)
  ARM_GCC := $(shell command -v arm-none-eabi-gcc 2>/dev/null)
  PREFIX := $(patsubst %/bin/arm-none-eabi-gcc,%,$(patsubst %.exe,%,$(ARM_GCC)))
endif
WIN := $(findstring MINGW,$(shell uname -s))$(findstring MSYS,$(shell uname -s))

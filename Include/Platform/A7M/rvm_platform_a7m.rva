<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Platform>
    <Name>A7M</Name>
    <Version>1.0</Version>
    <Wordlength>32</Wordlength>
    <Coprocessor>FPV4_SP,FPV5_SP,FPV5_DP</Coprocessor>
    <Buildsystem>Keil,Makefile,IAREW</Buildsystem>
    <Toolchain>ARMCC,GCC,ICCARM</Toolchain>
    <Guest>RMP,FRT,UO3,RTT,DJY</Guest>
    <Compatible>
        <C0>IAREW,ICCARM,FRT</C0>
        <C1>IAREW,ICCARM,Native</C1>
        <C2>IAREW,ICCARM,RMP</C2>
        <C3>IAREW,ICCARM,RTT</C3>
        <C4>IAREW,ICCARM,UO3</C4>
        <C5>Keil,ARMCC,FRT</C5>
        <C6>Keil,ARMCC,Native</C6>
        <C7>Keil,ARMCC,RMP</C7>
        <C8>Keil,ARMCC,RTT</C8>
        <C9>Keil,ARMCC,UO3</C9>
        <C10>Makefile,GCC,DJY</C10>
        <C11>Makefile,GCC,FRT</C11>
        <C12>Makefile,GCC,Native</C12>
        <C13>Makefile,GCC,RMP</C13>
        <C14>Makefile,GCC,RTT</C14>
        <C15>Makefile,GCC,UO3</C15>
    </Compatible>
    <Config>
        <C0>
            <Name>NVIC_Grouping</Name>
            <Macro>RME_A7M_NVIC_GROUPING</Macro>
            <Type>Choice</Type>
            <Range>P0S8,P1S7,P2S6,P3S5,P4S4,P5S3,P6S2,P7S1</Range>
            <Default>P2S6</Default>
        </C0>
        <C1>
            <Name>Systick_Value</Name>
            <Macro>RME_A7M_SYSTICK_VALUE</Macro>
            <Type>Range</Type>
            <Range>100,16777215</Range>
            <Default>168000</Default>
        </C1>
    </Config>
</Platform>

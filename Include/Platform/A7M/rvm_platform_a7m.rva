<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Platform>
    <Name>A7M</Name>
    <Version>1.0</Version>
    <Wordlength>32</Wordlength>
    <Coprocessor>FPV4_SP,FPV5_SP,FPV5_DP</Coprocessor>
    <Buildsystem>Keil,Makefile,IAREW</Buildsystem>
    <Toolchain>ARMCC,GCC,ICCARM</Toolchain>
    <Guest>RMP,FRT,UO3</Guest>
    <Compatible>
        <C0>Keil,ARMCC,Native</C0>
        <C1>Keil,ARMCC,RMP</C1>
        <C2>Makefile,GCC,Native</C2>
        <C3>Makefile,GCC,RMP</C3>
        <C4>Keil,ARMCC,FRT</C4>
        <C5>Makefile,GCC,FRT</C5>
        <C6>IAREW,ICCARM,Native</C6>
        <C7>IAREW,ICCARM,RMP</C7>
        <C8>IAREW,ICCARM,FRT</C8>
        <C9>Makefile,GCC,UO3</C9>
    </Compatible>
    <Config>
        <C0>
            <Name>NVIC_Grouping</Name>
            <Macro>RME_A7M_NVIC_GROUPING</Macro>
            <Type>Choice</Type>
            <Range>P0S8,P1S7,P2S6,P3S5,P4S4,P5S3,P6S2,P7S1</Range>
            <Default>P2S6</Default>
        </C0>
        <C1>
            <Name>Systick_Value</Name>
            <Macro>RME_A7M_SYSTICK_VALUE</Macro>
            <Type>Range</Type>
            <Range>100,16777215</Range>
            <Default>168000</Default>
        </C1>
    </Config>
</Platform>
